// --- Global Constants & Definitions ---
const String reCaptchaSiteKeyProd = String.fromEnvironment(
  'RECAPTCHA_SITE_KEY_PROD',
  defaultValue: '',
);

// --- MAIN ENTRY POINT ---
Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await _bootstrapApp();
}

Future<void> _bootstrapApp() async {
  try {
    await SystemChrome.setPreferredOrientations([
      DeviceOrientation.portraitUp,
      DeviceOrientation.portraitDown,
    ]);

    await dotenv.load(fileName: ".env");

    await Firebase.initializeApp(
      options: DefaultFirebaseOptions.currentPlatform,
    );

    if (kDebugMode && !kIsWeb) {
      FirebaseAppCheck.instance.getToken(true).then((String? token) {
        if (token != null) {
          debugPrint('------------------------------------------------------------');
          debugPrint('Firebase App Check DEBUG TOKEN: $token');
          debugPrint('------------------------------------------------------------');
        }
      });
    }

    final apiClient = PeoplesCoinApiClient();
    runApp(AppStateProviders(
      apiClient: apiClient,
      child: const BrightActsApp(),
    ));
  } catch (e, stack) {
    debugPrint("❌ FATAL ERROR during app bootstrap: $e");
    debugPrint(stack.toString());
    runApp(MaterialApp(
      home: Scaffold(
        backgroundColor: Colors.black,
        body: Center(
          child: Text(
            'App failed to start.\n$e',
            style: const TextStyle(color: Colors.redAccent),
            textAlign: TextAlign.center,
          ),
        ),
      ),
    ));
  }
}

